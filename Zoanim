			for i, n in ipairs(favourites) do
				if n == oldName then favourites[i] = newName break end
			end
			if animSettings[oldName] then
				animSettings[newName] = animSettings[oldName]
				animSettings[oldName] = nil
			end
			if animations[oldName] then
				animations[newName] = animations[oldName]
				animations[oldName] = nil
			end
			saveAnimations()
			saveAnimOrder()
			saveTabAnimOrder()
			saveAnimSettings()
			saveFavourites()
			rebuildAnimList()
		end)

		epLoopBtn.MouseButton1Click:Connect(function()
			animSettings[name].loop = not animSettings[name].loop
			epLoopBtn.Text = animSettings[name].loop and "ON" or "OFF"
			epLoopBtn.BackgroundColor3 = animSettings[name].loop and C.btnGreen or C.btnGray
		end)

		epFreezeBtn.MouseButton1Click:Connect(function()
			animSettings[name].freeze = not animSettings[name].freeze
			epFreezeBtn.Text = animSettings[name].freeze and "ON" or "OFF"
			epFreezeBtn.BackgroundColor3 = animSettings[name].freeze and C.btnGreen or C.btnGray
		end)

		epSaveBtn.MouseButton1Click:Connect(function()
			local bt2 = tonumber(epBlend.Text)
			local ft2 = tonumber(epFade.Text)
			local sp2 = tonumber(epSpeed.Text)
			if bt2 then animSettings[name].blendTime = bt2 end
			if ft2 then animSettings[name].fadeTime   = ft2 end
			if sp2 then animSettings[name].speed      = sp2 end
			saveAnimSettings()
		end)

		epAddTabBtn.MouseButton1Click:Connect(function()
			openTabPicker(name)
		end)

		epDelBtn.MouseButton1Click:Connect(function()
			currentDeleteTarget = name
			confirmLabel.Text = "Delete '" .. name .. "'?"
			centerPanel(confirmDeleteFrame)
			confirmDeleteFrame.Visible = true
		end)

		favBtn.MouseButton1Click:Connect(function()
			if isFavourite(name) then
				removeFavourite(name)
				favBtn.Text = "-"
				favBtn.TextColor3 = C.starOff
			else
				addFavourite(name)
				favBtn.Text = "*"
				favBtn.TextColor3 = C.star
			end
		end)

		playBtn.MouseButton1Click:Connect(function()
			if not currentAnimator then return end
			local anim = animations[name]
			if not anim then return end
			local as = animSettings[name]
			local useLoop   = as.loop   or guiState.globalLoop
			local useFreeze = as.freeze or guiState.globalFreeze
			local useBlend  = as.blendTime
			local useFade   = as.fadeTime
			local useSpeed  = as.speed
			if guiState.forceAnimations then
				local playing = currentAnimator:GetPlayingAnimationTracks()
				for _, t in pairs(playing) do
					if t.Priority ~= Enum.AnimationPriority.Core then
						t:Stop(useFade)
					end
				end
				anim.Priority = Enum.AnimationPriority.Action
			end
			anim.Looped = useLoop
			anim:Play(useBlend, 1, useSpeed)
			anim:AdjustSpeed(useSpeed)
			if useFreeze then
				task.delay(0.05, function()
					if anim.IsPlaying then anim:AdjustSpeed(0) end
				end)
			end
			pausedAnimations[name] = false
			pauseBtn.Text = "||"
			pauseBtn.BackgroundColor3 = C.btnOrange
		end)

		pauseBtn.MouseButton1Click:Connect(function()
			local anim = animations[name]
			if not anim then return end
			if not anim.IsPlaying and not pausedAnimations[name] then return end
			if pausedAnimations[name] then
				local as = animSettings[name]
				anim:AdjustSpeed(as.speed)
				pausedAnimations[name] = false
				pauseBtn.Text = "||"
				pauseBtn.BackgroundColor3 = C.btnOrange
			else
				anim:AdjustSpeed(0)
				pausedAnimations[name] = true
				pauseBtn.Text = ">"
				pauseBtn.BackgroundColor3 = C.btnGreen
			end
		end)

		stopBtn.MouseButton1Click:Connect(function()
			local anim = animations[name]
			if not anim then return end
			local as = animSettings[name]
			anim:Stop(as.fadeTime)
			pausedAnimations[name] = false
			pauseBtn.Text = "||"
			pauseBtn.BackgroundColor3 = C.btnOrange
		end)

		animationButtons[name] = {
			play = playBtn, pause = pauseBtn, stop = stopBtn, container = container,
		}
	end
end

rebuildTabs = function()
