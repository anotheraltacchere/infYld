				elseif k == "miniBtnX"              then guiState.toggleBtnX            = tonumber(v) or 458
				elseif k == "miniBtnY"              then guiState.toggleBtnY            = tonumber(v) or -10
				elseif k == "toggleBtnLocked"       then guiState.toggleBtnLocked       = v == "true"
				elseif k == "guiWidth"              then guiState.guiWidth              = tonumber(v) or 270
				elseif k == "guiHeight"             then guiState.guiHeight             = tonumber(v) or 420
				elseif k == "globalBlendTime"       then guiState.globalBlendTime       = tonumber(v) or 0.1
				elseif k == "globalFadeTime"        then guiState.globalFadeTime        = tonumber(v) or 0.1
				elseif k == "globalSpeed"           then guiState.globalSpeed           = tonumber(v) or 1
				elseif k == "globalLoop"            then guiState.globalLoop            = v == "true"
				elseif k == "globalFreeze"          then guiState.globalFreeze          = v == "true"
				elseif k == "forceAnimations"       then guiState.forceAnimations       = v == "true"
				elseif k == "btnTransparency"       then guiState.btnTransparency       = tonumber(v) or 0
				elseif k == "guiTransparency"       then guiState.guiTransparency       = tonumber(v) or 0
				elseif k == "toggleBtnTransparency" then guiState.toggleBtnTransparency = tonumber(v) or 0.5
				elseif k == "miniBtnTransparency"   then guiState.toggleBtnTransparency = tonumber(v) or 0.5
				end
			end
		end
	end
end

