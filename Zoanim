		end

		contentArea.Position = UDim2.new(0, 0, 0, 82)
		contentArea.Size = UDim2.new(1, 0, 0, guiState.guiHeight - 82)
	else
		subTabsRow.Visible = false
		contentArea.Position = UDim2.new(0, 0, 0, 58)
		contentArea.Size = UDim2.new(1, 0, 0, guiState.guiHeight - 58)
