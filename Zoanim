			delTabBtn.MouseButton1Click:Connect(function()
				for i2, t in ipairs(customTabs) do
					if t == tabName then table.remove(customTabs, i2) break end
				end
				subTabs[tabName] = nil
				for key in pairs(animPerTabOrder) do
					if key:sub(1, #tabName + 2) == tabName .. "::" then
						animPerTabOrder[key] = nil
					end
				end
				saveCustomTabs()
				saveTabAnimOrder()
				if guiState.activeTab == tabName then
					guiState.activeTab = "All Anims"
					guiState.activeSubTab = "Default"
				end
				rebuildTabs()
				rebuildAnimList()
			end)
		end
	end

	local activeTab = guiState.activeTab
	local subs = subTabs[activeTab]
	local isCustomTab = activeTab ~= "All Anims" and activeTab ~= "Favourites"

	if isCustomTab then
		subTabsRow.Visible = true

