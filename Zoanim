local function ensureAnimSetting(name)
	if not animSettings[name] then
		animSettings[name] = {
			blendTime = guiState.globalBlendTime,
			fadeTime  = guiState.globalFadeTime,
			speed     = guiState.globalSpeed,
			loop      = false,
			freeze    = false,
		}
	end
end

local function isFavourite(name)
	for _, v in ipairs(favourites) do
		if v == name then return true end
	end
	return false
end

local function addFavourite(name)
	if not isFavourite(name) then
		table.insert(favourites, name)
		saveFavourites()
	end
end

local function removeFavourite(name)
	for i, v in ipairs(favourites) do
		if v == name then
			table.remove(favourites, i)
			saveFavourites()
			return
		end
	end
end

local function getTabKey(tab, sub)
	return tab .. "::" .. (sub or "Default")
end

local function getAnimsForTab(tab, sub)
	local result = {}
	if tab == "All Anims" then
		for _, name in ipairs(animOrder) do
			if animationIds[name] then table.insert(result, name) end
		end
	elseif tab == "Favourites" then
		for _, name in ipairs(favourites) do
			if animationIds[name] then table.insert(result, name) end
		end
	else
		local key = getTabKey(tab, sub)
		local order = animPerTabOrder[key] or {}
		for _, name in ipairs(order) do
			if animationIds[name] then table.insert(result, name) end
		end
	end
	return result
end

local function filterBySearch(list)
	if searchQuery == "" then return list end
	local q = searchQuery:lower()
	local filtered = {}
	for _, name in ipairs(list) do
		local nameMatch = name:lower():find(q, 1, true)
		local idMatch = animationIds[name] and animationIds[name]:lower():find(q, 1, true)
		if nameMatch or idMatch then
			table.insert(filtered, name)
		end
	end
	return filtered
end

for name in pairs(animationIds) do
	ensureAnimSetting(name)
	local found = false
	for _, n in ipairs(animOrder) do
		if n == name then found = true break end
	end
	if not found then table.insert(animOrder, name) end
end

