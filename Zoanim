		tabContainerLayout.Parent = tabContainer

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, math.max(48, #tabName * 7 + 10), 0, 22)
		btn.BackgroundColor3 = isActive and C.tabActive or C.btnGray
		btn.BackgroundTransparency = bt
