local function openTabPicker(animName)
	for _, child in ipairs(tabPickerScroll:GetChildren()) do
		if child:IsA("TextButton") or child:IsA("TextLabel") or child:IsA("Frame") then child:Destroy() end
	end
	if #customTabs == 0 then
		local noTabsLbl = Instance.new("TextLabel")
		noTabsLbl.Size = UDim2.new(1, 0, 0, 28)
		noTabsLbl.BackgroundTransparency = 1
		noTabsLbl.Text = "No custom tabs yet."
		noTabsLbl.TextSize = 10
		noTabsLbl.TextColor3 = C.textSec
		noTabsLbl.Font = Enum.Font.Gotham
		noTabsLbl.ZIndex = 192
		noTabsLbl.LayoutOrder = 1
		noTabsLbl.Parent = tabPickerScroll
	else
		local order = 1
		for _, tabName in ipairs(customTabs) do
			local tabBtn = Instance.new("TextButton")
			tabBtn.Size = UDim2.new(1, 0, 0, 26)
			tabBtn.BackgroundColor3 = C.tabPickRow
			tabBtn.Text = tabName
			tabBtn.TextSize = 10
			tabBtn.TextColor3 = C.textPri
			tabBtn.Font = Enum.Font.GothamBold
			tabBtn.TextXAlignment = Enum.TextXAlignment.Left
			tabBtn.LayoutOrder = order
			tabBtn.ZIndex = 192
			tabBtn.BorderSizePixel = 0
			tabBtn.Parent = tabPickerScroll
			local tbc = Instance.new("UICorner")
			tbc.CornerRadius = UDim.new(0, 4)
			tbc.Parent = tabBtn
			local tbpad = Instance.new("UIPadding")
			tbpad.PaddingLeft = UDim.new(0, 8)
			tbpad.Parent = tabBtn
			order = order + 1

			tabBtn.MouseButton1Click:Connect(function()
				local key = getTabKey(tabName, "Default")
				animPerTabOrder[key] = animPerTabOrder[key] or {}
				local already = false
				for _, n in ipairs(animPerTabOrder[key]) do
					if n == animName then already = true break end
				end
				if not already then
					table.insert(animPerTabOrder[key], animName)
					saveTabAnimOrder()
				end
				tabPickerPanel.Visible = false
				rebuildTabs()
			end)

			local subs = subTabs[tabName] or {}
			for _, subName in ipairs(subs) do
				local subBtn = Instance.new("TextButton")
				subBtn.Size = UDim2.new(1, -12, 0, 22)
				subBtn.BackgroundColor3 = C.tabPickSub
				subBtn.Text = "  " .. tabName .. " / " .. subName
				subBtn.TextSize = 9
				subBtn.TextColor3 = C.textSec
				subBtn.Font = Enum.Font.Gotham
				subBtn.TextXAlignment = Enum.TextXAlignment.Left
				subBtn.LayoutOrder = order
				subBtn.ZIndex = 192
				subBtn.BorderSizePixel = 0
				subBtn.Parent = tabPickerScroll
				local sbc = Instance.new("UICorner")
				sbc.CornerRadius = UDim.new(0, 3)
				sbc.Parent = subBtn
				local sbpad = Instance.new("UIPadding")
				sbpad.PaddingLeft = UDim.new(0, 16)
				sbpad.Parent = subBtn
				order = order + 1

				subBtn.MouseButton1Click:Connect(function()
					local key = getTabKey(tabName, subName)
					animPerTabOrder[key] = animPerTabOrder[key] or {}
					local already = false
					for _, n in ipairs(animPerTabOrder[key]) do
						if n == animName then already = true break end
					end
					if not already then
						table.insert(animPerTabOrder[key], animName)
						saveTabAnimOrder()
					end
					tabPickerPanel.Visible = false
					rebuildTabs()
				end)
			end
		end
	end
	centerPanel(tabPickerPanel)
	tabPickerPanel.Visible = true
end

