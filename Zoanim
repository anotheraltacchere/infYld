		for line in c:gmatch("[^\r\n]+") do
			local k, v = line:match("([^=]+)=(.+)")
			if k and v then
				if     k == "posX"                  then guiState.posX                  = tonumber(v) or 10
				elseif k == "posY"                  then guiState.posY                  = tonumber(v) or 10
				elseif k == "toggleBtnX"            then guiState.toggleBtnX            = tonumber(v) or 458
