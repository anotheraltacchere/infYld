				delSubBtn.BackgroundTransparency = bt
				delSubBtn.Text = "x"
				delSubBtn.TextSize = 8
				delSubBtn.TextColor3 = C.textPri
				delSubBtn.Font = Enum.Font.GothamBold
				delSubBtn.LayoutOrder = 2
				delSubBtn.BorderSizePixel = 0
				delSubBtn.Parent = subContainer
				local dsbc = Instance.new("UICorner")
				dsbc.CornerRadius = UDim.new(0, 3)
				dsbc.Parent = delSubBtn

				delSubBtn.MouseButton1Click:Connect(function()
					local st = subTabs[activeTab]
					if st then
						for i2, s in ipairs(st) do
							if s == subName then table.remove(st, i2) break end
						end
					end
					local key = getTabKey(activeTab, subName)
					animPerTabOrder[key] = nil
					saveCustomTabs()
					saveTabAnimOrder()
