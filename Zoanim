local function safeRead(path)
	if isfile and readfile and isfile(path) then
		local ok, r = pcall(readfile, path)
		if ok then return r end
	end
	return nil
end

local function safeWrite(path, content)
	if writefile then pcall(writefile, path, content) end
end

local function ensureFolder(path)
	if isfolder and makefolder and not isfolder(path) then makefolder(path) end
end

local function getBase()
	ensureFolder("workspace")
	ensureFolder("workspace/Zo Anims")
	return "workspace/Zo Anims"
end

local function saveAnimations()
	local lines = {}
	for name, id in pairs(animationIds) do
		table.insert(lines, name .. "|" .. id)
	end
	safeWrite(getBase() .. "/Zo Anims.txt", table.concat(lines, "\n"))
end

local function loadAnimations()
	local c = safeRead(getBase() .. "/Zo Anims.txt")
	if c then
		local loaded = {}
		for line in c:gmatch("[^\r\n]+") do
			local name, id = line:match("([^|]+)|(.+)")
			if name and id then loaded[name] = id end
		end
		if next(loaded) then animationIds = loaded end
	end
end

local function saveFavourites()
	safeWrite(getBase() .. "/Favourites.txt", table.concat(favourites, "\n"))
end

local function loadFavourites()
	local c = safeRead(getBase() .. "/Favourites.txt")
	if c then
		favourites = {}
		for line in c:gmatch("[^\r\n]+") do
			if line ~= "" then table.insert(favourites, line) end
		end
	end
end

local function saveCustomTabs()
	local lines = {}
	for _, tab in ipairs(customTabs) do
		local subs = subTabs[tab] or {}
		table.insert(lines, tab .. "|" .. table.concat(subs, ","))
	end
	safeWrite(getBase() .. "/CustomTabs.txt", table.concat(lines, "\n"))
end

local function loadCustomTabs()
	local c = safeRead(getBase() .. "/CustomTabs.txt")
	if c then
		customTabs = {}
		subTabs = {}
		for line in c:gmatch("[^\r\n]+") do
			local tabName, subsStr = line:match("([^|]+)|?(.*)")
			if tabName and tabName ~= "" then
				table.insert(customTabs, tabName)
				subTabs[tabName] = {}
				if subsStr and subsStr ~= "" then
					for sub in subsStr:gmatch("[^,]+") do
						table.insert(subTabs[tabName], sub)
					end
				end
			end
		end
	end
end

local function saveAnimSettings()
	local lines = {}
	for name, s in pairs(animSettings) do
		table.insert(lines, name.."|"..tostring(s.blendTime).."|"..tostring(s.fadeTime).."|"..tostring(s.speed).."|"..tostring(s.loop).."|"..tostring(s.freeze))
	end
	safeWrite(getBase() .. "/AnimSettings.txt", table.concat(lines, "\n"))
end

local function loadAnimSettings()
	local c = safeRead(getBase() .. "/AnimSettings.txt")
	if c then
		for line in c:gmatch("[^\r\n]+") do
			local name, bt, ft, sp, lp, fr = line:match("([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)")
			if name then
				animSettings[name] = {
					blendTime = tonumber(bt) or 0.1,
					fadeTime  = tonumber(ft) or 0.1,
					speed     = tonumber(sp) or 1,
					loop      = lp == "true",
					freeze    = fr == "true",
				}
			end
		end
	end
end

