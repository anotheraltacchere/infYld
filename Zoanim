	local bt = guiState.btnTransparency

	for i, tabName in ipairs(allTabs) do
		local isActive = guiState.activeTab == tabName
		local isCustom = tabName ~= "All Anims" and tabName ~= "Favourites"

		local tabContainer = Instance.new("Frame")
		tabContainer.Size = UDim2.new(0, math.max(58, #tabName * 7 + (isCustom and 28 or 14)), 0, 22)
