local function applyAllUITransparency(t)
	titleBar.BackgroundTransparency = t
	titleBarFix.BackgroundTransparency = t
	searchBox.BackgroundTransparency = t
	viewBtn.BackgroundTransparency = t
	tabsRow.BackgroundTransparency = t
	subTabsRow.BackgroundTransparency = t
	animScrollFrame.BackgroundTransparency = t
	addAnimArea.BackgroundTransparency = t
	addAnimNameBox.BackgroundTransparency = t
	addAnimIdBox.BackgroundTransparency = t
	addAnimBtn.BackgroundTransparency = t
	for _, child in ipairs(animScrollFrame:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundTransparency = t
			for _, sub in ipairs(child:GetChildren()) do
				if sub.Name == "favBtn" then
					sub.BackgroundTransparency = 1
				elseif sub:IsA("TextButton") or sub:IsA("TextBox") then
					pcall(function() sub.BackgroundTransparency = t end)
				elseif sub:IsA("Frame") then
					pcall(function() sub.BackgroundTransparency = t end)
					for _, deep in ipairs(sub:GetChildren()) do
						if deep.Name == "favBtn" then
							deep.BackgroundTransparency = 1
						elseif deep:IsA("TextButton") or deep:IsA("TextBox") then
							pcall(function() deep.BackgroundTransparency = t end)
						end
					end
				end
			end
		end
	end
	for _, child in ipairs(tabsRow:GetChildren()) do
		if child:IsA("Frame") then
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("TextButton") then
					pcall(function() sub.BackgroundTransparency = t end)
				end
			end
		end
	end
	for _, child in ipairs(subTabsRow:GetChildren()) do
		if child:IsA("Frame") then
			for _, sub in ipairs(child:GetChildren()) do
				if sub:IsA("TextButton") then
					pcall(function() sub.BackgroundTransparency = t end)
				end
			end
		end
	end
end

