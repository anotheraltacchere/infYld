	end
	saveAnimations()
	saveAnimOrder()
	saveAnimSettings()
	if currentAnimator then
		local anim = Instance.new("Animation")
		anim.AnimationId = animId
		local ok, loaded = pcall(function() return currentAnimator:LoadAnimation(anim) end)
		if ok and loaded then animations[animName] = loaded end
	end
	addAnimNameBox.Text = ""
	addAnimIdBox.Text   = ""
	rebuildAnimList()
end)

local function loadAnimsForCharacter(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if not humanoid then return end
	local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator", 10)
	if not animator then return end
	currentAnimator = animator
	for _, anim in pairs(animations) do
		pcall(function() anim:Stop() end)
	end
	animations = {}
	pausedAnimations = {}
	for name, id in pairs(animationIds) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, loaded = pcall(function() return animator:LoadAnimation(anim) end)
		if ok and loaded then animations[name] = loaded end
	end
end

